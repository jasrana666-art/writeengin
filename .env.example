# WriteEngin - Production Environment Variables
# Copy this to .env and fill in real values for production

# Flask
SECRET_KEY=change-this-to-a-random-64-char-string-in-production
FLASK_DEBUG=false
PORT=5000

# Database (SQLite for dev, PostgreSQL for production)
DATABASE_URL=sqlite:///writeengin.db
# For production: DATABASE_URL=postgresql://user:pass@host:5432/writeengin

# ══════════════════════════════════════════════════════════════════════════
# AI PROVIDERS (Free options first - no credit card required)
# Set at least ONE free key to enable AI content generation.
# Fallback: template mode (no API key needed, offline mode)
# ══════════════════════════════════════════════════════════════════════════

# OpenRouter (FREE - no credit card)
# Sign up: https://openrouter.ai/sign-up → API Keys
# Free models: 20+ models (llama, gemini, mistral, etc.)
# Rate limit: 50 requests/day free tier, 20 RPM
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Groq (FREE - no credit card)
# Sign up: https://console.groq.com/keys
# Free tier: 30,000 tokens/minute, 14,400 requests/day
# Models: llama-3.3-70b-versatile, mixtral-8x7b-32768
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ══════════════════════════════════════════════════════════════════════════
# PAID OPTIONS (add your keys for priority access)
# ══════════════════════════════════════════════════════════════════════════

# OpenAI (GPT-4o-mini) — paid, needs API key with credits
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic (Claude 3.5 Sonnet) — paid, needs API key with credits
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Stripe Payments
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Razorpay Payments (India)
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...

# Email (SMTP)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@writeengin.com

# WordPress (optional - users can also set per-account)
WDP_URL=
WDP_USERNAME=
WDP_APP_PASSWORD=
